<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/month_screen_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_background"
        android:elevation="8dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Ngày giỗ" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Lưu ngày mất của người thân (nhập ngày dương hoặc âm đều được quy về âm lịch). Đúng ngày giỗ, khu «Văn khấn cho ngày» sẽ tự liệt kê bài cúng giỗ đầu, giỗ hết hay giỗ thường kèm tên người đã khuất."
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gio_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/month_card_background"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/gio_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="Chưa có ngày giỗ nào."
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:textStyle="italic" />

    <Button
        android:id="@+id/add_gio_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@drawable/month_primary_button_background"
        android:text="Thêm ngày giỗ"
        android:textColor="@color/textLight"
        android:textSize="14sp" />

</LinearLayout>
