<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/donation_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lịch Vạn Niên miễn phí và không cần trả tiền. Nếu bạn thấy hữu ích, có thể ủng hộ mình một tách trà hoặc cốc cà phê. Khoản ủng hộ không mở khóa thêm tính năng nào."
        android:textColor="@color/textPrimary"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/donation_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/donation_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Thanh toán qua Google Play. Các mức ủng hộ là cố định; Google Play không hỗ trợ nhập số tiền tùy ý."
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />
</LinearLayout>