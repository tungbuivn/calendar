<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/month_screen_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_background"
        android:elevation="8dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Gia phả" />

    <TextView
        android:id="@+id/gia_pha_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Chạm một người để đổi mốc, chạm hai lần để sửa. Giữ lâu rồi kéo ô này thả lên ô khác để nối cha mẹ – con hoặc vợ chồng. Kéo để dời khung, chụm hai ngón để phóng. Ô xám là người đã khuất."
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <com.calendar.tbt.FamilyTreeView
        android:id="@+id/gia_pha_tree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/month_card_background" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gia_pha_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/month_card_background"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gia_pha_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="Chưa có ai trong gia phả. Hãy thêm người đứng khấn trước."
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_person_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/month_primary_button_background"
            android:text="Thêm người"
            android:textColor="@color/textLight"
            android:textSize="14sp" />

        <Button
            android:id="@+id/relation_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_modern"
            android:text="Quan hệ"
            android:textColor="@color/textLight"
            android:textSize="14sp" />

        <Button
            android:id="@+id/view_mode_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_modern"
            android:text="Danh sách"
            android:textColor="@color/textLight"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
